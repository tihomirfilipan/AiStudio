<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Accord.Imaging" Version="3.8.0" />
    <PackageReference Include="Accord.Video.DirectShow" Version="3.8.0" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text dictionaries for UiTranslator, one file per language -->
    <EmbeddedResource Include="Translations\UiText_*.txt" LogicalName="AgLibrary.Translations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>